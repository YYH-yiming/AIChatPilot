# Production deployment
SPRING_PROFILES_ACTIVE=prod
USER_SERVER_PORT=8081
GATEWAY_SERVER_PORT=8080

MYSQL_URL=jdbc:mysql://prod-db:3306/aichatpilot?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=app_user
MYSQL_PASSWORD=change-me

REDIS_HOST=prod-redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DATABASE=0
REDIS_TIMEOUT=3000ms

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION=86400000
KNIFE4J_ENABLE=false
APP_LOG_LEVEL=WARN

NACOS_SERVER_ADDR=prod-nacos:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
NACOS_DISCOVERY_ENABLED=true
NACOS_CONFIG_ENABLED=true
