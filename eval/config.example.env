# 复制本文件为 eval/.env 并填入真实值；.env 不要提交到仓库。

# ---------- 知识库服务接入 ----------
# 鉴权模式：direct=直连 knowledge 带身份头；gateway=登录拿 JWT 走网关
EVAL_AUTH_MODE=direct
KNOWLEDGE_BASE_URL=http://localhost:8082
GATEWAY_BASE_URL=http://localhost:8080

# direct 模式下透传的身份头（下游 GatewayHeaderAuthenticationFilter 信任）
X_USER_ID=1
X_TENANT_ID=1

# gateway 模式下用于登录拿 JWT
EVAL_USERNAME=
EVAL_PASSWORD=

# 知识库「名称 -> kbId」映射（运行后用 list_bases 查到真实 id 再填）
# JSON 字符串
KB_NAME_TO_ID={"客户服务政策库":1,"产品价格与合同库":2,"客服运营与工单流程库":3,"公司介绍与销售口径库":4,"内部办公与入职规范库":5}

# ---------- 生成用例 / RAGAs 判分用的 LLM（OpenAI 兼容）----------
LLM_API_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=

# ---------- Embedding（OpenAI 兼容，RAGAs 需要）----------
EMBEDDING_API_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ---------- 知识库语料目录（轨道1 离线抓取用）----------
KNOWLEDGE_DOCS_DIR=../docs/knowledgeDocs
