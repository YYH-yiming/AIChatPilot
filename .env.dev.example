# Shared development environment
SPRING_PROFILES_ACTIVE=dev
USER_SERVER_PORT=8081
GATEWAY_SERVER_PORT=8080
KNOWLEDGE_SERVER_PORT=8082
GATEWAY_CONNECT_TIMEOUT=3000
GATEWAY_RESPONSE_TIMEOUT=60s

MYSQL_URL=jdbc:mysql://dev-db:3306/aichatpilot?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me

REDIS_HOST=dev-redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DATABASE=0
REDIS_TIMEOUT=3000ms

KAFKA_BOOTSTRAP_SERVERS=localhost:9095
KAFKA_CONSUMER_GROUP=knowledge-document-consumer
KAFKA_TOPIC_DOCUMENT_UPLOAD=knowledge.document.upload
KAFKA_TOPIC_PARTITIONS=1
KAFKA_TOPIC_REPLICAS=1

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION=86400000
KNIFE4J_ENABLE=true
APP_LOG_LEVEL=INFO

NACOS_SERVER_ADDR=dev-nacos:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
NACOS_DISCOVERY_ENABLED=true
NACOS_CONFIG_ENABLED=true
MINIO_ENDPOINT=http://dev-minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_NAME=aichatpilot-docs

EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_API_KEY=change-me
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

LLM_PROVIDER=ark
LLM_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
LLM_API_KEY=change-me
LLM_MODEL=doubao-seed-2-0-mini-260215
LLM_OPENAI_COMPATIBLE=true
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

MILVUS_HOST=dev-milvus
MILVUS_PORT=19530
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_DATABASE=default

ELASTICSEARCH_URIS=http://dev-es:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

KNOWLEDGE_CHUNK_STRATEGY=fixed
KNOWLEDGE_CHUNK_SIZE=1000
KNOWLEDGE_CHUNK_OVERLAP=100
KNOWLEDGE_ASYNC_ENABLED=true
KNOWLEDGE_RETRIEVAL_TOP_K=5
KNOWLEDGE_RETRIEVAL_RRF_K=60
KNOWLEDGE_RETRIEVAL_INDEX_ON_UPLOAD=true
KNOWLEDGE_RETRIEVAL_FAIL_ON_INDEX_ERROR=false
KNOWLEDGE_RETRIEVAL_DENSE_ENABLED=true
KNOWLEDGE_RETRIEVAL_SPARSE_ENABLED=true
RAG_TOP_K=5
RAG_EMPTY_ANSWER=我没有在知识库中找到相关信息
